+"""Anthropic Claude models through Anthropic's OpenAI-compatible endpoint.
+
+Added for the Lingxi v1.5 reproduction, which answers `ask_repository_agent`
+questions with Claude instead of Gemini. The embedder is untouched: it keeps
+using `OpenAIClient` with `OPENAI_API_KEY` / `OPENAI_BASE_URL`, so this client
+reads its own environment variables.
+"""
+
+import os
+from typing import Any, Callable, Literal, Optional
+
+from api.openai_client import OpenAIClient
+
+ANTHROPIC_OPENAI_BASE_URL = "https://api.anthropic.com/v1/"
+
+
+class AnthropicClient(OpenAIClient):
+    def __init__(
+        self,
+        api_key: Optional[str] = None,
+        chat_completion_parser: Callable[[Any], Any] = None,
+        input_type: Literal["text", "messages"] = "text",
+        base_url: Optional[str] = None,
+        env_base_url_name: str = "ANTHROPIC_OPENAI_BASE_URL",
+        env_api_key_name: str = "ANTHROPIC_API_KEY",
+    ):
+        super().__init__(
+            api_key=api_key,
+            chat_completion_parser=chat_completion_parser,
+            input_type=input_type,
+            base_url=base_url or os.getenv(env_base_url_name, ANTHROPIC_OPENAI_BASE_URL),
+            env_base_url_name=env_base_url_name,
+            env_api_key_name=env_api_key_name,
+        )
