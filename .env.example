# Copy to .env (gitignored). Read by the scripts, by v1.5 itself and by scripts/start_deepwiki.sh.

# Anthropic Console API key (pay as you go): the agents, the knowledge writer,
# DeepWiki's answers and Lingxi Advisor's relevance checks.
ANTHROPIC_API_KEY=
# DeepWiki embeddings (text-embedding-3-small).
OPENAI_API_KEY=
# Lingxi Advisor's GitHub search; v1.5 also refuses to import without it.
GITHUB_TOKEN=

# Optional overrides (defaults shown)
# LINGXI_WORK_DIR=./work
# LINGXI_AGENT_MODEL=claude-haiku-4-5-20251001
# LINGXI_KNOWLEDGE_MODEL=claude-haiku-4-5-20251001
# LINGXI_DEEPWIKI_MODEL=claude-haiku-4-5-20251001
# LINGXI_ADVISOR_JUDGE_MODEL=claude-haiku-4-5-20251001
# LINGXI_TEXT_EDITOR_TOOL_TYPE=text_editor_20250728
